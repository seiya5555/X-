# Anthropic API（Claude）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twitter / X API v2
TWITTER_API_KEY=your_twitter_consumer_key
TWITTER_API_SECRET=your_twitter_consumer_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_token_secret

# Obsidian Vault のフォルダパス（リール台本システム用）
# 例（Mac）  : /Users/yourname/Documents/MyVault
# 例（Windows）: C:/Users/yourname/Documents/MyVault
OBSIDIAN_VAULT_PATH=
